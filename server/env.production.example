# Configuración del Servidor de Correo para Producción
# Copia este archivo a .env en la carpeta server/ antes de ejecutar el servidor

# Puerto del servidor
PORT=3001

# Configuración SMTP (Gmail)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false

# Credenciales de correo
