<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>

    <!-- Habilita el módulo de reescritura de URL -->
    <rewrite>
      <rules>
        <!-- Define la regla para manejar el routing de React -->
        <rule name="React Routes" stopProcessing="true">
          <!--
            Esta regla se aplica a cualquier URL solicitada por el usuario.
          -->
          <match url=".*" />

          <!--
            Estas condiciones excluyen archivos físicos y directorios reales
            para que el servidor pueda servir CSS, JS, imágenes, etc.
          -->
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" pattern=".*\.map" />
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" pattern=".*\.css" />
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" pattern=".*\.js" />
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" pattern=".*\.jpg" />
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" pattern=".*\.png" />
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" pattern=".*\.gif" />
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" pattern=".*\.ico" />
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" pattern=".*\.svg" />
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" pattern=".*\.woff" />
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" pattern=".*\.woff2" />
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" pattern=".*\.ttf" />
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" pattern=".*\.eot" />
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true"/>
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>

          <!--
            Si las condiciones anteriores se cumplen (es decir, no es un archivo real),
            el servidor reescribe internamente la ruta al index.html principal.
            Esto permite que el router de React tome el control de la URL.
          -->
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>

    <!--
      Opcional: puedes añadir un manejo básico de tipos MIME si IIS no reconoce
      los archivos de mapas de origen (source maps) o WebAssembly.
    -->
    <staticContent>
            <!-- Limpia (elimina) cualquier entrada mimeMap que pueda existir en la configuración global de IIS -->
            <clear />

            <!-- Agrega el tipo MIME estándar para archivos HTML -->
            <mimeMap fileExtension=".html" mimeType="text/html" />

            <!-- Ahora puedes agregar las tuyas sin conflicto -->
            <mimeMap fileExtension=".wasm" mimeType="application/wasm" />
            <mimeMap fileExtension=".map" mimeType="application/json" />

            <!-- También es buena práctica añadir JS y CSS si no están configurados globalmente -->
            <mimeMap fileExtension=".js" mimeType="application/javascript" />
            <mimeMap fileExtension=".css" mimeType="text/css" />

        </staticContent>
  </system.webServer>
</configuration>
